# Server
PORT=5000
NODE_ENV=development
# Boleh diisi lebih dari satu origin dipisah koma, mis:
# CLIENT_URL=http://localhost:5173,https://arsip.papuabaratdaya.go.id
# Saat dijalankan via Docker+Nginx satu origin (lihat README), boleh diisi "*"
CLIENT_URL=http://localhost:5173

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ekatarsip_db

# JWT
JWT_SECRET=ganti_dengan_secret_key_yang_sangat_rahasia
JWT_EXPIRES_IN=8h

# Upload
UPLOAD_MAX_SIZE_MB=15

# Email (SMTP) — dipakai untuk mengirim kode OTP verifikasi email &
# lupa password. Jika SMTP_HOST dikosongkan, sistem akan mencetak kode OTP
# ke log/console server (mode pengembangan) alih-alih mengirim email sungguhan.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="E-KATARSIP <no-reply@papuabaratdaya.go.id>"

# Masa berlaku kode OTP (menit)
OTP_EXPIRY_MINUTES=10
