# File konfigurasi untuk docker-compose. Salin menjadi ".env" lalu sesuaikan nilainya.
#   cp .env.example .env

# Database (nama harus sama dengan yang dipakai di database/schema.sql: ekatarsip_db)
DB_NAME=ekatarsip_db
DB_PASSWORD=ganti_dengan_password_mysql_yang_kuat

# JWT
JWT_SECRET=ganti_dengan_secret_key_yang_sangat_rahasia_dan_acak
JWT_EXPIRES_IN=8h

# Origin frontend yang diizinkan mengakses API. Karena frontend & backend berada
# di belakang satu Nginx (kontainer frontend), permintaan bersifat same-origin —
# boleh dibiarkan "*".
CLIENT_URL=*

# Ukuran maksimum file arsip yang diunggah (MB)
UPLOAD_MAX_SIZE_MB=15

# Port host yang memetakan ke kontainer frontend (diakses oleh Nginx reverse proxy di VPS)
FRONTEND_PORT=8080

# Email (SMTP) — wajib diisi agar kode OTP verifikasi email & lupa password
# benar-benar terkirim. Jika dikosongkan, kode OTP hanya dicetak ke log
# kontainer backend (`docker compose logs -f backend`) — cukup untuk uji coba,
# TIDAK disarankan untuk produksi.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="E-KATARSIP <no-reply@papuabaratdaya.go.id>"
OTP_EXPIRY_MINUTES=10
